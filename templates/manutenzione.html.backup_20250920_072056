{% extends "base.html" %}
{% block content %}
<div class="container py-4">
  <h1 class="h3 mb-4"><i class="bi bi-tools me-2"></i>Richiedi manutenzione</h1>

  <form method="post" action="{{ url_for('richiedi_manutenzione') }}" id="manutenzioneForm" class="row g-3">
    <div class="col-12">
      <label class="form-label">Tipo richiesta</label>
      <select class="form-select" name="tipo" id="tipo" required>
        <option value="" selected disabled>Seleziona...</option>
        <option value="elettrica" {% if (request.args.get('tipo') or tipo_sel) == 'elettrica' %}selected{% endif %}>1. Manutenzione elettrica</option>
        <option value="meccanica" {% if (request.args.get('tipo') or tipo_sel) == 'meccanica' %}selected{% endif %}>2. Manutenzione meccanica</option>
        <option value="servizi"   {% if (request.args.get('tipo') or tipo_sel) == 'servizi'   %}selected{% endif %}>3. Servizi</option>
      </select>
    </div>

    <div class="col-12">
      <label class="form-label">Descrizione</label>
      <textarea class="form-control" name="descrizione" rows="4" required placeholder="Descrivi l'intervento..."></textarea>
    </div>

    <div class="col-md-6">
      <label class="form-label">Richiedente</label>
      <input type="text" class="form-control" name="richiedente" required placeholder="Nome e cognome">
    </div>

    <div class="col-md-6">
      <label class="form-label">Centro cottura / Terminale di servizio</label>
      <input type="text" class="form-control" name="centro" required placeholder="Es. Centro cottura Milano Nord">
    </div>

    <!-- Fornitore (solo per elettrica/meccanica) -->
    <div class="col-md-6" id="fornitoreWrap" style="display:none;">
      <label class="form-label">Fornitore desiderato</label>
      <select class="form-select" name="fornitore" id="fornitoreSelect">
        <option value="" selected>— Seleziona fornitore —</option>
        {% for f in fornitori or [] %}
          <option value="{{ f }}">{{ f }}</option>
        {% endfor %}
      </select>
      <div class="form-text">L’elenco mostra i fornitori <strong>qualificati</strong> per la tipologia selezionata.</div>
    </div>

    <!-- Destinatario (solo per servizi) -->
    <div class="col-md-6" id="destinatarioWrap" style="display:none;">
      <label class="form-label">Destinatario</label>
      <input type="text" class="form-control" name="destinatario" id="destinatarioInput" placeholder="Inserisci destinatario per servizi">
    </div>

    <div class="col-md-6">
      <label class="form-label">Data intervento</label>
      <input type="date" class="form-control" name="data_intervento">
    </div>

    <div class="col-12 d-flex gap-2">
      <button type="submit" name="azione" value="genera_pdf" class="btn btn-primary">
        <i class="bi bi-file-earmark-pdf me-1"></i> Genera PDF
      </button>
      <a href="#" onclick="history.back(); return false;" class="btn btn-outline-secondary">Annulla</a>
    </div>
  </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const tipo = document.getElementById('tipo');
  const fornitoreWrap = document.getElementById('fornitoreWrap');
  const destinatarioWrap = document.getElementById('destinatarioWrap');

  function toggleFields() {
    const v = tipo.value;
    if (v === 'elettrica' || v === 'meccanica') {
      fornitoreWrap.style.display = '';
      destinatarioWrap.style.display = 'none';
      const d = document.getElementById('destinatarioInput'); if (d) d.value='';
    } else if (v === 'servizi') {
      fornitoreWrap.style.display = 'none';
      destinatarioWrap.style.display = '';
      const s = document.getElementById('fornitoreSelect'); if (s) s.value='';
    } else {
      fornitoreWrap.style.display = 'none';
      destinatarioWrap.style.display = 'none';
    }
  }

  tipo.addEventListener('change', () => {
    toggleFields();
    const v = tipo.value;
    if (v === 'elettrica' || v === 'meccanica' || v === 'servizi') {
      const base = "{{ url_for('richiedi_manutenzione') }}";
      const current = new URL(window.location.href);
      const currentTipo = current.searchParams.get('tipo') || '';
      if (currentTipo !== v) {
        window.location.href = base + "?tipo=" + encodeURIComponent(v);
      }
    }
  });

  toggleFields();
});
</script>
{% endblock %}
